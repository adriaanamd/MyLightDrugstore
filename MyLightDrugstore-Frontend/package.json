{
  "name": "mylightdrugstore-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check .",
    "test:unit": "vitest run",
    "test:architecture": "node scripts/check-fsd-boundaries.mjs --enforce && node scripts/check-source-size.mjs --enforce && node scripts/check-code-quality.mjs --enforce",
    "test": "pnpm run test:unit && pnpm run test:architecture && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.56",
    "@tanstack/router-plugin": "^1.168.40",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.1"
  }
}
