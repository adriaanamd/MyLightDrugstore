{
  "name": "mylightdrugstore-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "format:check": "node scripts/check-format.mjs",
    "test:unit": "vitest run",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:architecture": "node scripts/check-fsd-boundaries.mjs --enforce && node scripts/check-source-size.mjs --enforce && node scripts/check-code-quality.mjs --enforce",
    "test": "pnpm run test:unit && pnpm run test:architecture && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/router-plugin": "^1.168.47",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.6",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "@babel/types": "7.29.7",
      "source-map-js": "^1.2.2"
    }
  }
}
